{
  "name": "@colibri-kit/ui",
  "version": "0.1.0",
  "description": "Colibri UI: headless, unstyled, framework-agnostic UI primitives",
  "homepage": "https://colibri-kit.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levancho/colibri-kit.git"
  },
  "bugs": {
    "url": "https://github.com/levancho/colibri-kit/issues"
  },
  "keywords": [
    "ui",
    "components",
    "headless",
    "accessible",
    "css",
    "design-system",
    "dialog",
    "tooltip",
    "tabs",
    "no-build",
    "freemarker",
    "thymeleaf",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./src/elements/*.js",
    "./src/core/auto.js",
    "./src/core/auto-lazy.js",
    "./dist/colibri-ui.min.js",
    "./dist/lazy/auto-lazy.js",
    "./dist/*.css",
    "./themes/*.css",
    "./themes/packs/*.css"
  ],
  "exports": {
    ".": "./src/core/index.js",
    "./core/*": "./src/core/*.js",
    "./core/*.js": "./src/core/*.js",
    "./elements/*": "./src/elements/*.js",
    "./elements/*.js": "./src/elements/*.js",
    "./react": "./src/react/index.js",
    "./themes/*": "./themes/*",
    "./min": "./dist/colibri-ui.min.js",
    "./lazy": "./dist/lazy/auto-lazy.js",
    "./min.css": "./dist/colibri-ui.min.css",
    "./registry": "./registry/colibri.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "python3 -m http.server 8395",
    "test:e2e": "node test/e2e/run.mjs && node test/e2e/foundations.e2e.mjs && node test/e2e/navigation-styles.e2e.mjs && node test/e2e/dashboards.e2e.mjs && node test/e2e/architecture.e2e.mjs && node test/e2e/source-tabs.e2e.mjs && node test/e2e/java-templates.e2e.mjs && node test/e2e/motion-exit.e2e.mjs && node test/e2e/studio-bridge.e2e.mjs && node test/e2e/demo-apps.e2e.mjs && node test/e2e/dashboard-domains.e2e.mjs && node test/e2e/dashboard-devices.e2e.mjs && node test/e2e/dashboard-designs.e2e.mjs && node test/e2e/application-components.e2e.mjs && node test/e2e/dashboard-theme-preview.e2e.mjs && node test/e2e/audit-host.e2e.mjs && node test/e2e/dist-bundles.e2e.mjs && node test/e2e/widget-builder.e2e.mjs && node test/e2e/native.e2e.mjs && node tools/native-smoke.mjs",
    "sink": "python3 tools/kitchen-sink.py && python3 tools/readme-catalog.py && python3 tools/registry.py",
    "registry": "python3 tools/registry.py",
    "build": "sh site/build.sh",
    "check:architecture": "python3 tools/check-architecture.py",
    "test:foundations": "node test/e2e/foundations.e2e.mjs",
    "test:cross-browser": "node test/e2e/cross-browser.mjs",
    "test:java": "mvn -f java/colibri-templates/pom.xml verify",
    "test:consumer": "node test/e2e/consumer.e2e.mjs",
    "test:react-compat": "node test/e2e/react-compat.e2e.mjs",
    "test:cross-browser:linux": "node tools/test-linux-browser.mjs",
    "build:ui": "node tools/lazy-registry.mjs && node tools/build-ui.mjs",
    "test:dist": "node test/e2e/dist-bundles.e2e.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "esbuild": "0.25.10",
    "fflate": "0.8.3",
    "jsdom": "^25.0.0",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-web": "0.21.4"
  },
  "bin": {
    "colibri": "bin/colibri.mjs",
    "colibri-mcp": "bin/colibri-mcp.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "src",
    "themes",
    "dist",
    "freemarker",
    "bin",
    "registry",
    "skills",
    "LICENSE",
    "README.md",
    "thymeleaf",
    "java/colibri-templates/pom.xml",
    "docs/java-templates.md",
    "packages/colibri-css/dist",
    "starters",
    "docs/getting-started.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Levan Dvalishvili"
}
