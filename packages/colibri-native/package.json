{
  "name": "@colibri-kit/native",
  "version": "0.1.0",
  "description": "Colibri for React Native and Expo: themed components from one hue. No required dependencies; optional entries for gestures, SVG charts and icons, and safe areas.",
  "homepage": "https://colibri-kit.io/native/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levancho/colibri-kit.git",
    "directory": "packages/colibri-native"
  },
  "bugs": {
    "url": "https://github.com/levancho/colibri-kit/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "design-tokens",
    "oklch",
    "dark-mode",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "react-native": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./full": {
      "types": "./types/full.d.ts",
      "default": "./src/full/index.js"
    },
    "./gestures": {
      "types": "./types/gestures.d.ts",
      "default": "./src/gestures/index.js"
    },
    "./svg": {
      "types": "./types/svg.d.ts",
      "default": "./src/svg/index.js"
    },
    "./safe-area": {
      "types": "./types/safe-area.d.ts",
      "default": "./src/safe-area/index.js"
    },
    "./theme": "./src/theme.js",
    "./color": "./src/color.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "index.d.ts",
    "types",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71",
    "react-native-gesture-handler": ">=2.14",
    "react-native-reanimated": ">=3.6",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=13"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
