    "html": "<section data-application-component=\"projects\"><header><h3>Projects</h3><p>Track current work.</p></header><div class=\"project-grid\"><article class=\"project-card\"><img src=\"dashboards/assets/studio-office.jpg\" alt=\"Project Atlas\" width=\"320\" height=\"180\" loading=\"lazy\"><div class=\"project-body\"><h3>Project Atlas</h3><p>Customer portal launch \u00b7 8 tasks remaining</p><label>Progress<progress max=\"100\" value=\"65\">65</progress></label><button class=\"btn\" type=\"button\" data-app-action=\"view-project\" data-id=\"atlas\">View project</button></div></article><article class=\"project-card\"><img src=\"dashboards/assets/meeting-space.jpg\" alt=\"Mobile release\" width=\"320\" height=\"180\" loading=\"lazy\"><div class=\"project-body\"><h3>Mobile release</h3><p>Version 2.4 \u00b7 QA in progress</p><label>Progress<progress max=\"100\" value=\"85\">85</progress></label><button class=\"btn\" type=\"button\" data-app-action=\"view-project\" data-id=\"mobile\">View project</button></div></article></div></section>"
