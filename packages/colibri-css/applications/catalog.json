    "html": "<section class=\"app-card\" data-application-component=\"table\"><header><h3>Customers</h3><p>Search and inspect customer records.</p></header><label>Search records<input type=\"search\" data-app-filter=\"\" aria-label=\"Search records\"></label><div class=\"app-table-wrap\"><table class=\"app-table\"><caption>Customers</caption><thead><tr><th scope=\"col\">Name</th><th scope=\"col\">Plan</th><th scope=\"col\">Revenue</th><th scope=\"col\">Actions</th></tr></thead><tbody><tr data-record-id=\"maya\"><td>Maya Chen</td><td>Pro</td><td>$240</td><td><button class=\"btn\" type=\"button\" data-app-action=\"view-record\" data-id=\"maya\">View record</button></td></tr><tr data-record-id=\"alex\"><td>Alex Rivera</td><td>Team</td><td>$1,100</td><td><button class=\"btn\" type=\"button\" data-app-action=\"view-record\" data-id=\"alex\">View record</button></td></tr><tr data-record-id=\"sam\"><td>Sam Patel</td><td>Starter</td><td>$79</td><td><button class=\"btn\" type=\"button\" data-app-action=\"view-record\" data-id=\"sam\">View record</button></td></tr></tbody></table></div></section>"
