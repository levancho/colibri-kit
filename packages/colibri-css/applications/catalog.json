    "title": "Conversation desk",
    "description": "Selectable ticket queue, assignment, status and replies.",
    "layout": "support",
    "html": "<div class=\"support-layout\" data-application-component=\"conversation\"><section class=\"support-queue\" aria-label=\"Tickets\"><button class=\"support-ticket\" type=\"button\" data-app-action=\"select-ticket\" data-id=\"2081\" aria-current=\"true\"><span class=\"portrait\" data-face=\"0\"><img src=\"dashboards/assets/portraits.jpg\" alt=\"Maya Chen\" width=\"320\" height=\"180\" loading=\"lazy\"></span><strong>Maya Chen</strong><p>Cannot invite a teammate</p><small>Open</small></button><button class=\"support-ticket\" type=\"button\" data-app-action=\"select-ticket\" data-id=\"2080\" aria-current=\"false\"><span class=\"portrait\" data-face=\"1\"><img src=\"dashboards/assets/portraits.jpg\" alt=\"Alex Rivera\" width=\"320\" height=\"180\" loading=\"lazy\"></span><strong>Alex Rivera</strong><p>Update our invoice address</p><small>Pending</small></button></section><article class=\"support-thread\"><h2 data-ticket-title=\"\">Cannot invite a teammate</h2><p data-ticket-customer=\"\">Maya Chen</p><label>Assigned to<select data-ticket-assignee=\"\" aria-label=\"Assign ticket\"><option value=\"Unassigned\" selected>Unassigned</option><option value=\"Jordan Lee\">Jordan Lee</option><option value=\"Maya Chen\">Maya Chen</option></select></label><label>Status<select data-ticket-status=\"\" aria-label=\"Ticket status\"><option value=\"Open\" selected>Open</option><option value=\"Pending\">Pending</option><option value=\"Resolved\">Resolved</option></select></label><div data-ticket-messages=\"\"><div class=\"support-message\"><p>Could you check our workspace member limit?</p></div></div><form class=\"app-form\" data-app-form=\"reply\"><label>Reply<textarea name=\"reply\" required maxlength=\"2000\"></textarea></label><button type=\"submit\" class=\"btn\">Save demo reply</button><p role=\"status\"></p></form></article></div>"
