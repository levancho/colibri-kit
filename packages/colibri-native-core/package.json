{
  "name": "@colibri-kit/native-core",
  "version": "0.1.0",
  "description": "Colibri React Native Core: themed components for React Native and Expo from one hue. No dependencies beyond react and react-native.",
  "homepage": "https://colibri-kit.io/native/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levancho/colibri-kit.git",
    "directory": "packages/colibri-native-core"
  },
  "bugs": {
    "url": "https://github.com/levancho/colibri-kit/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "design-tokens",
    "oklch",
    "dark-mode",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "react-native": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./internal": "./src/internal-public.js",
    "./theme": "./src/theme.js",
    "./color": "./src/color.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "index.d.ts",
    "types",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "license": "MIT"
}
