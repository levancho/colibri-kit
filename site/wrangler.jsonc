{
  // Colibri Kit site: static assets on a Worker, same pattern as the other l3v.ai subdomains.
  "name": "colibri-kit-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "colibri.l3v.ai", "custom_domain": true }]
}
