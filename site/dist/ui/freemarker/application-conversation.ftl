[#ftl output_format="HTML" auto_esc=true]
[#macro component model]
<div class="support-layout" data-application-component="conversation"><section class="support-queue" aria-label="Tickets">[#list model.tickets as ticket]<button class="support-ticket" type="button" data-app-action="select-ticket" data-id="${ticket.id}" aria-current="${(ticket.id == model.selected.id)?c}"><span class="portrait" data-face="${ticket.face}"><img src="${ticket.image}" alt="${ticket.customer}" width="320" height="180" loading="lazy"></span><strong>${ticket.customer}</strong><p>${ticket.title}</p><small>${ticket.status}</small></button>[/#list]</section><article class="support-thread"><h2 data-ticket-title="">${model.selected.title}</h2><p data-ticket-customer="">${model.selected.customer}</p><label>Assigned to<select data-ticket-assignee="" aria-label="Assign ticket"><option value="Unassigned"[#if model.selected.assigned == "Unassigned"] selected[/#if]>Unassigned</option>[#list model.agents as agent]<option value="${agent}"[#if agent == model.selected.assigned] selected[/#if]>${agent}</option>[/#list]</select></label><label>Status<select data-ticket-status="" aria-label="Ticket status">[#list model.statuses as status]<option value="${status}"[#if status == model.selected.status] selected[/#if]>${status}</option>[/#list]</select></label><div data-ticket-messages=""><div class="support-message"><p>${model.selected.message}</p></div></div><form class="app-form" data-app-form="reply"><label>Reply<textarea name="reply" required maxlength="2000"></textarea></label><button type="submit" class="btn">Save demo reply</button><p role="status"></p></form></article></div>
[/#macro]
