[#ftl output_format="HTML" auto_esc=true]
[#-- Colibri UI (@colibri-kit/ui): shared FreeMarker macros. Emit ONLY the data-ui contract (no classes/styles).
     [#import "/colibri/freemarker/ui.ftl" as ui]
     Generic (works for every component, incl. future ones):
       [@ui.c "popover" {"id":"x"}] [@ui.p "trigger" tag="button"]Open[/@ui.p] [@ui.p "content"]…[/@ui.p] [/@ui.c]
     Typed helpers below cover the common components. attrs={} always passes extra attributes through.
     HTML auto-escaping is enabled. Pass structured content as nested bodies or captured markup; strings remain escaped text. --]

[#-- s(v): a value as attribute/data text. Numbers use ?c so 1500 stays "1500" (not "1,500") and 12.5 stays "12.5" in every locale. --]
[#function s v][#if v?is_number || v?is_boolean][#return v?c][#else][#return v?string][/#if][/#function]
[#function a attrs={}][#local result][#list attrs as k,v][#if v?is_boolean][#if v] ${k}[/#if][#else] ${k}="${s(v)}"[/#if][/#list][/#local][#return result][/#function]
[#function d name val][#local result][#if val?has_content] data-${name}="${s(val)}"[/#if][/#local][#return result][/#function]

[#-- ── generic ── --]
[#macro c ui attrs={} tag="div"]<${tag} data-ui="${ui}"${a(attrs)}>[#nested]</${tag}>[/#macro]
[#macro p part attrs={} tag="div"][#if tag=="button"]<button type="button" data-ui-part="${part}"${a(attrs)}>[#nested]</button>[#else]<${tag} data-ui-part="${part}"${a(attrs)}>[#nested]</${tag}>[/#if][/#macro]

[#-- ── Base ── --]
[#macro button variant="" size="" type="button" loading=false disabled=false attrs={}]<button type="${type}" data-ui="button"${d("variant",variant)}${d("size",size)}[#if loading] data-loading[/#if][#if disabled] disabled[/#if]${a(attrs)}>[#nested]</button>[/#macro]
[#macro badge variant="" removable=false attrs={}]<span[#if removable] data-ui="badge"[/#if] data-ui-part="badge"${d("variant",variant)}${a(attrs)}>[#nested][#if removable] <button type="button" data-ui-part="remove">×</button>[/#if]</span>[/#macro]
[#macro alert variant="" role="status" dismissible=true attrs={}]<div data-ui="dismiss" role="${role}"${d("variant",variant)}${a(attrs)}><span>[#nested]</span>[#if dismissible] <button type="button" data-ui-part="close" aria-label="Close">×</button>[/#if]</div>[/#macro]
[#macro avatar src="" alt="" fallback="" attrs={}]<span data-ui="avatar"${a(attrs)}>[#if src?has_content]<img data-ui-part="image" src="${src?esc}" alt="${alt?esc}">[/#if]<span data-ui-part="fallback">${fallback?esc}</span></span>[/#macro]
[#macro card title="" description="" attrs={}]<article data-ui-part="card"${a(attrs)}>[#if title?has_content]<header><h3 data-ui-part="title">${title?esc}</h3>[#if description?has_content]<p data-ui-part="description">${description?esc}</p>[/#if]</header>[/#if]<div data-ui-part="content">[#nested]</div></article>[/#macro]
[#macro progress value="" label="" attrs={}]<div data-ui="progress"${d("value",value)}[#if label?has_content] aria-label="${label?esc}"[/#if]${a(attrs)}><div data-ui-part="indicator"></div></div>[/#macro]
[#macro separator vertical=false decorative=false]<div data-ui="separator"[#if vertical] data-orientation="vertical"[/#if][#if decorative] data-decorative[/#if]></div>[/#macro]
[#-- skeleton: the theme sizes it 100% x 1rem. w/h write a style attribute (blocked by a strict CSP style-src); under
     a strict policy size it with a class through attrs instead. --]
[#macro skeleton w="" h="" attrs={}]<div data-ui-part="skeleton" aria-hidden="true"[#if w?has_content || h?has_content] style="[#if w?has_content]width:${w?esc};[/#if][#if h?has_content]height:${h?esc}[/#if]"[/#if]${a(attrs)}></div>[/#macro]
[#macro toaster position="bottom-right" max=3]<ol data-ui="toaster" data-position="${position}" data-max="${s(max)}" aria-label="Notifications"></ol>[/#macro]
[#macro clipboard text="" target="" attrs={}]<button type="button" data-ui="clipboard"${d("text",text)}${d("target",target)}${a(attrs)}>[#nested]</button>[/#macro]
[#macro themeSwitch key="colibri.theme" attrs={}]<button type="button" data-ui="theme-switch" data-storage-key="${key}"${a(attrs)}>[#nested]</button>[/#macro]
[#macro scrollArea maxHeight="" label="" attrs={}]<div data-ui="scroll-area"${d("max-height",maxHeight)}[#if label?has_content] aria-label="${label?esc}"[/#if]${a(attrs)}>[#nested]</div>[/#macro]

[#-- overlays: dialog / alert-dialog / sheet / drawer. trigger = button label (markup). --]
[#macro dialog trigger title kind="dialog" description="" side="" id="" attrs={}]
<div data-ui="${kind}"${d("side",side)}[#if id?has_content] id="${id}"[/#if]${a(attrs)}>
  [#if trigger?has_content]<button type="button" data-ui-part="trigger">${trigger}</button>[/#if]
  <dialog data-ui-part="content"><h2 data-ui-part="title">${title?esc}</h2>[#if description?has_content]<p data-ui-part="description">${description?esc}</p>[/#if]
  [#nested]</dialog>
</div>[/#macro]
[#macro close returnValue="" variant="" autofocus=false]<button type="button" data-ui-part="close"${d("ui-return",returnValue)}${d("variant",variant)}[#if autofocus] autofocus[/#if]>[#nested]</button>[/#macro]

[#-- floating: popover / tooltip / hover-card. trigger is markup. --]
[#macro popover trigger kind="popover" side="" align="" triggerTag="button" attrs={}]
<div data-ui="${kind}"${d("side",side)}${d("align",align)}${a(attrs)}>[#if triggerTag=="button"]<button type="button" data-ui-part="trigger">${trigger}</button>[#else]<${triggerTag} data-ui-part="trigger">${trigger}</${triggerTag}>[/#if]<div data-ui-part="content" hidden>[#nested]</div></div>[/#macro]
[#-- nested = the trigger, which must carry data-ui-part="trigger" and be focusable, e.g. <button data-ui-part="trigger" aria-label="Edit">✎</button> --]
[#macro tooltip text side="top" delay="" attrs={}]<span data-ui="tooltip"${d("side",side)}${d("delay",delay)}${a(attrs)}>[#nested]<span data-ui-part="content" hidden>${text?esc}</span></span>[/#macro]

[#-- accordion / collapsible. items=[{"value","title","content"(markup),"disabled"}] --]
[#macro accordion items type="single" default="" collapsible=true attrs={}]
<div data-ui="accordion" data-type="${type}"${d("default-value",default)}[#if collapsible] data-collapsible[/#if]${a(attrs)}>
[#list items as it]<div data-ui-part="item" data-value="${it.value?esc}"[#if (it.disabled!false)] data-disabled[/#if]><h3><button type="button" data-ui-part="trigger">${it.title?esc}</button></h3><div data-ui-part="content">${it.content}</div></div>
[/#list][#nested]</div>[/#macro]
[#macro collapsible trigger open=false attrs={}]<div data-ui="collapsible"[#if open] data-default-open[/#if]${a(attrs)}><button type="button" data-ui-part="trigger">${trigger}</button><div data-ui-part="content">[#nested]</div></div>[/#macro]

[#-- menus. items=[{"label","shortcut","disabled","type":"checkbox|radio|separator|label","checked","value","variant","href","items":[…sub…]}] --]
[#macro menuItems items]
[#list items as it][#local t = it.type!"item"]
  [#if t=="separator"]<hr data-ui-part="separator">
  [#elseif t=="label"]<div data-ui-part="label">${it.label?esc}</div>
  [#elseif it.items??]<div data-ui-part="sub"><button type="button" data-ui-part="sub-trigger">${it.label?esc}</button><div data-ui-part="sub-content" hidden>[@menuItems it.items /]</div></div>
  [#elseif it.href??]<a data-ui-part="item" href="${it.href?esc}">${it.label?esc}</a>
  [#else]<button type="button" data-ui-part="item"[#if t!="item"] data-type="${t}"[/#if]${d("value",it.value!"")}${d("variant",it.variant!"")}[#if t!="item"] aria-checked="${(it.checked!false)?c}"[/#if][#if (it.disabled!false)] disabled[/#if]>${it.label?esc}[#if it.shortcut??] <kbd>${it.shortcut?esc}</kbd>[/#if]</button>
  [/#if]
[/#list][/#macro]
[#macro dropdown trigger items kind="dropdown-menu" attrs={}]<div data-ui="${kind}"${a(attrs)}>[#if kind=="context-menu"]<div data-ui-part="area">${trigger}</div>[#else]<button type="button" data-ui-part="trigger">${trigger}</button>[/#if]<div data-ui-part="content" hidden>[@menuItems items /]</div></div>[/#macro]
[#-- menus=[{"label","items":[…]}] --]
[#macro menubar menus label="Menu" attrs={}]<div data-ui="menubar" aria-label="${label?esc}"${a(attrs)}>[#list menus as m]<div data-ui-part="menu"><button type="button" data-ui-part="trigger">${m.label?esc}</button><div data-ui-part="content" hidden>[@menuItems m.items /]</div></div>[/#list]</div>[/#macro]

[#-- ── Navigation ── --]
[#-- crumbs=[{"label","href"}] last one is current --]
[#macro breadcrumb crumbs label="Breadcrumb"]<nav aria-label="${label?esc}" data-ui-part="breadcrumb"><ol>[#list crumbs as c]<li>[#if c?has_next && c.href??]<a href="${c.href?esc}">${c.label?esc}</a>[#else]<span aria-current="page">${c.label?esc}</span>[/#if]</li>[/#list]</ol></nav>[/#macro]
[#macro pagination total page=1 href="" label="Pagination" prevLabel="" nextLabel=""]<nav data-ui="pagination" data-total="${total?c}" data-page="${page?c}"${d("href",href)}${d("label-prev",prevLabel)}${d("label-next",nextLabel)} aria-label="${label?esc}"></nav>[/#macro]
[#-- steps=[{"label","content"(markup)}] --]
[#macro stepper steps linear=false back="Back" next="Next" finish="Finish" attrs={}]<div data-ui="stepper"[#if linear] data-linear[/#if]${a(attrs)}><ol data-ui-part="list">[#list steps as s]<li data-ui-part="step">${s.label?esc}</li>[/#list]</ol>
[#list steps as s]<section data-ui-part="panel">${s.content}</section>[/#list]
<div><button type="button" data-ui-part="prev">${back?esc}</button><button type="button" data-ui-part="next">${next?esc}</button><button type="button" data-ui-part="finish">${finish?esc}</button></div></div>[/#macro]
[#macro sidebar id collapsible="offcanvas" key="" label="Sidebar" attrs={}]<aside id="${id}" data-ui="sidebar" data-collapsible="${collapsible}"${d("storage-key",key)} aria-label="${label?esc}"${a(attrs)}>[#nested]</aside>[/#macro]
[#macro sidebarToggle target label="Toggle sidebar"]<button type="button" data-ui-sidebar-toggle="#${target}" aria-label="${label?esc}">[#nested]</button>[/#macro]
[#macro scrollspy offset=80 target="" attrs={}]<nav data-ui="scrollspy" data-offset="${offset?c}"${d("target",target)}${a(attrs)}>[#nested]</nav>[/#macro]
[#macro spyLink href]<a data-ui-part="link" href="${href?esc}">[#nested]</a>[/#macro]
[#macro navigationMenu label="Main" attrs={}]<nav data-ui="navigation-menu" aria-label="${label?esc}"${a(attrs)}><ul data-ui-part="list">[#nested]</ul></nav>[/#macro]
[#macro navMenu trigger]<li data-ui-part="menu"><button type="button" data-ui-part="trigger">${trigger?esc}</button><div data-ui-part="content">[#nested]</div></li>[/#macro]

[#-- item list. Use [@ui.item title=… description=… media=… href=…] actions as nested --]
[#macro itemGroup label="" attrs={}]<div data-ui="item-group"[#if label?has_content] aria-label="${label?esc}"[/#if]${a(attrs)}>[#nested]</div>[/#macro]
[#macro item title description="" media="" href="" value="" disabled=false]<div data-ui-part="item"${d("value",value)}[#if disabled] data-disabled[/#if]>[#if media?has_content]<span data-ui-part="media">${media}</span>[/#if]<div data-ui-part="content">[#if href?has_content]<a data-ui-part="title-link" href="${href?esc}"><span data-ui-part="title">${title?esc}</span></a>[#else]<div data-ui-part="title">${title?esc}</div>[/#if][#if description?has_content]<div data-ui-part="description">${description?esc}</div>[/#if]</div><div data-ui-part="actions">[#nested]</div></div>[/#macro]

[#-- ── Forms ── (name = form field name, so Spring binding works) --]
[#macro field label id="" description="" error="" attrs={}]<div data-ui="field"[#if error?has_content] data-invalid[/#if]${a(attrs)}><label data-ui-part="label"[#if id?has_content] for="${id}"[/#if]>${label?esc}</label>[#nested][#if description?has_content]<p data-ui-part="description">${description?esc}</p>[/#if]<p data-ui-part="error">${error?esc}</p></div>[/#macro]
[#macro input name value="" type="text" id="" placeholder="" required=false attrs={}]<input data-ui-part="control" type="${type}" name="${name}"[#if id?has_content] id="${id}"[/#if] value="${value?esc}"[#if placeholder?has_content] placeholder="${placeholder?esc}"[/#if][#if required] required[/#if]${a(attrs)}>[/#macro]
[#macro checkbox name checked=false value="true" label="" controls="" attrs={}]<label><input type="checkbox" data-ui="checkbox" name="${name}" value="${value?esc}"[#if checked] checked[/#if]${d("controls",controls)}${a(attrs)}> ${label?esc}</label>[/#macro]
[#macro switch name checked=false label="" attrs={}]<label><input type="checkbox" data-ui="switch" name="${name}"[#if checked] checked[/#if]${a(attrs)}> ${label?esc}</label>[/#macro]
[#-- options=[{"value","label","disabled"}] or groups=[{"label","options":[…]}] --]
[#macro radioGroup name options value="" label="" orientation="vertical"]<div data-ui="radio-group" role="radiogroup" data-orientation="${orientation}"[#if label?has_content] aria-label="${label?esc}"[/#if]>[#list options as o]<label data-ui-part="item"><input type="radio" name="${name}" value="${s(o.value)}"[#if s(o.value)==s(value)] checked[/#if][#if (o.disabled!false)] disabled[/#if]> ${o.label?esc}</label>[/#list]</div>[/#macro]
[#macro optionsOf options][#list options as o]<div data-ui-part="option" data-value="${o.value?esc}"[#if (o.disabled!false)] data-disabled[/#if][#if o.keywords??] data-keywords="${o.keywords?esc}"[/#if]>${o.label?esc}</div>[/#list][/#macro]
[#macro select name options=[] groups=[] value="" placeholder="" multiple=false attrs={}]<div data-ui="select" data-name="${name}"${d("default-value",value)}${d("placeholder",placeholder)}[#if multiple] data-multiple[/#if]${a(attrs)}><button type="button" data-ui-part="trigger"><span data-ui-part="value"></span></button><div data-ui-part="content" hidden>[@optionsOf options /][#list groups as g]<div data-ui-part="group"><div data-ui-part="label">${g.label?esc}</div>[@optionsOf g.options /]</div>[/#list]</div></div>[/#macro]
[#macro combobox name options value="" placeholder="" multiple=false allowCustom=false empty="No results" label="" attrs={}]<div data-ui="combobox" data-name="${name}"${d("default-value",value)}[#if multiple] data-multiple[/#if][#if allowCustom] data-allow-custom[/#if]${a(attrs)}>[#if multiple]<div data-ui-part="chips"></div>[/#if]<input data-ui-part="input"[#if placeholder?has_content] placeholder="${placeholder?esc}"[/#if][#if label?has_content] aria-label="${label?esc}"[/#if]><div data-ui-part="content" hidden>[@optionsOf options /]<div data-ui-part="empty">${empty?esc}</div></div></div>[/#macro]
[#-- groups=[{"label","options":[…]}] --]
[#macro command groups placeholder="Type a command…" hotkey="" empty="No results"]<div data-ui="command"${d("hotkey",hotkey)}><input data-ui-part="input" placeholder="${placeholder?esc}" aria-label="${placeholder?esc}"><div data-ui-part="list">[#list groups as g]<div data-ui-part="group"><div data-ui-part="label">${g.label?esc}</div>[@optionsOf g.options /]</div>[/#list]<div data-ui-part="empty">${empty?esc}</div></div></div>[/#macro]
[#macro slider name value min=0 max=100 step=1 labels=[] attrs={}][#local vs=s(value)?split(",")]<div data-ui="slider" data-name="${name}" data-min="${min?c}" data-max="${max?c}" data-step="${step?c}" data-value="${s(value)}"${a(attrs)}><div data-ui-part="track"><div data-ui-part="range"></div></div>[#list vs as v]<span data-ui-part="thumb" aria-label="${(labels[v?index]!"Value")?esc}"></span>[/#list]</div>[/#macro]
[#macro pinInput name length=6 type="numeric" mask=false label="Code"]<div data-ui="pin-input" data-name="${name}" data-length="${length?c}" data-type="${type}"[#if mask] data-mask[/#if] aria-label="${label?esc}"></div>[/#macro]
[#macro togglePassword name value="" placeholder="" label="Password"]<div data-ui="toggle-password"><input type="password" data-ui-part="input" name="${name}" value="${value?esc}" aria-label="${label?esc}"[#if placeholder?has_content] placeholder="${placeholder?esc}"[/#if]><button type="button" data-ui-part="toggle" aria-label="Show password">👁</button></div>[/#macro]
[#macro textarea name value="" autosize=true maxRows=8 maxlength="" label=""]<textarea data-ui="textarea" name="${name}"[#if autosize] data-autosize data-max-rows="${maxRows?c}"[/#if][#if maxlength?has_content] maxlength="${maxlength}"[/#if][#if label?has_content] aria-label="${label?esc}"[/#if]>${value?esc}</textarea>[/#macro]
[#macro fileInput name multiple=true accept="" maxSize="" drop="Drop files here or click to browse"]<div data-ui="file-input"><input type="file" data-ui-part="input" name="${name}"[#if multiple] multiple[/#if][#if accept?has_content] accept="${accept}"[/#if]${d("max-size",maxSize)}><div data-ui-part="dropzone">${drop?esc}</div><ul data-ui-part="list"></ul></div>[/#macro]
[#macro imageInput name src="" change="Change" remove="Remove"]<div data-ui="image-input"${d("default-src",src)}><img data-ui-part="preview" alt=""[#if src?has_content] src="${src?esc}"[/#if] width="80" height="80"><input type="file" accept="image/*" data-ui-part="input" name="${name}" hidden><button type="button" data-ui-part="change">${change?esc}</button><button type="button" data-ui-part="remove">${remove?esc}</button><input type="hidden" data-ui-part="removed" name="${name}_remove"></div>[/#macro]
[#-- repeater: nested = ONE row template using __i__ as index, e.g. name="items[__i__].name"; rows = existing rows markup --]
[#macro repeater min=0 max=50 add="+ Add" rows=""]<div data-ui="repeater" data-min="${min?c}" data-max="${max?c}"><template data-ui-part="template"><div data-ui-part="row">[#nested]<button type="button" data-ui-part="remove" aria-label="Remove row">−</button></div></template><div data-ui-part="list">${rows}</div><button type="button" data-ui-part="add">${add?esc}</button></div>[/#macro]
[#macro rating name value=0 max=5 readonly=false label="Rating"]<div data-ui="rating" data-name="${name}" data-max="${max?c}" data-value="${value?c}"[#if readonly] data-readonly[/#if] aria-label="${label?esc}"></div>[/#macro]
[#macro colorPicker name value="#000000" swatches=[]]<div data-ui="color-picker" data-name="${name}"><input type="color" data-ui-part="input" value="${value?esc}" aria-label="Color"><input data-ui-part="text" name="${name}" aria-label="Hex value">[#list swatches as s]<button type="button" data-ui-part="swatch" data-value="${s?esc}"></button>[/#list]</div>[/#macro]
[#-- items=[{"value","label"}] --]
[#macro sortable items name="" label="Order"]<ul data-ui="sortable"${d("name",name)} aria-label="${label?esc}">[#list items as it]<li data-ui-part="item" data-value="${it.value?esc}">${it.label?esc}</li>[/#list]</ul>[/#macro]
[#macro toggle pressed=false label="" attrs={}]<button type="button" data-ui="toggle" aria-pressed="${pressed?c}"[#if label?has_content] aria-label="${label?esc}"[/#if]${a(attrs)}>[#nested]</button>[/#macro]
[#-- items=[{"value","label"(markup),"aria"}] --]
[#macro toggleGroup items type="single" value="" label="" name=""]<div data-ui="toggle-group" data-type="${type}"${d("default-value",value)}${d("name",name)}[#if label?has_content] aria-label="${label?esc}"[/#if]>[#list items as it]<button type="button" data-ui-part="item" data-value="${it.value?esc}"[#if it.aria??] aria-label="${it.aria?esc}"[/#if]>${it.label}</button>[/#list]</div>[/#macro]
[#macro calendar mode="single" value="" min="" max="" months=1 locale=""]<div data-ui="calendar" data-mode="${mode}"${d("value",value)}${d("min",min)}${d("max",max)} data-months="${months?c}"${d("locale",locale)}></div>[/#macro]
[#macro datePicker name value="" mode="single" min="" max="" locale="" placeholder="YYYY-MM-DD" label="Date"]<div data-ui="date-picker" data-name="${name}" data-mode="${mode}"><input data-ui-part="input" value="${value?esc}" placeholder="${placeholder?esc}" aria-label="${label?esc}"><button type="button" data-ui-part="trigger" aria-label="Choose date">📅</button><div data-ui-part="content" hidden>[@calendar mode=mode value=value min=min max=max locale=locale /]</div></div>[/#macro]
[#-- tabs: see ui-tabs.ftl (kept for compatibility); dialog: ui-dialog.ftl or [@ui.dialog] above --]
[#macro tabs tabs id="" default="" orientation="horizontal" activation="auto" attrs={}]<div data-ui="tabs"[#if id?has_content] id="${id}"[/#if]${d("default-value",default)} data-orientation="${orientation}" data-activation="${activation}"${a(attrs)}><div data-ui-part="list">[#list tabs as t]<button type="button" data-ui-part="trigger" data-value="${t.value?esc}"[#if (t.disabled!false)] data-disabled[/#if]>${t.label?esc}</button>[/#list]</div>[#nested]</div>[/#macro]
[#macro panel value attrs={}]<div data-ui-part="panel" data-value="${value?esc}"${a(attrs)}>[#nested]</div>[/#macro]
[#macro datatable pageSize=10 remote=false search="Search…" attrs={}]<div data-ui="datatable" data-page-size="${pageSize?c}"[#if remote] data-remote[/#if]${a(attrs)}><input data-ui-part="search" placeholder="${search?esc}" aria-label="${search?esc}">[#nested]<p data-ui-part="empty" hidden>No results</p><div data-ui-part="info" aria-live="polite"></div><nav data-ui="pagination" data-total="1" data-page="1" aria-label="Table pages"></nav></div>[/#macro]


[#-- ================= Conversation ================= --]
[#macro bubble variant="muted" reactions=[] collapsible=false attrs={}]<div data-ui="bubble" data-variant="${variant}"[#if collapsible] data-collapsible[/#if]${a(attrs)}><div data-ui-part="content">[#nested]</div>[#if reactions?has_content]<div data-ui-part="reactions">[#list reactions as r]<button type="button" data-ui-part="reaction" data-value="${r?esc}">${r?esc} <span data-ui-part="count">0</span></button>[/#list]</div>[/#if][#if collapsible]<button type="button" data-ui-part="toggle">Show more</button>[/#if]</div>[/#macro]
[#macro message from="assistant" avatar="" name="" time="" actions=[] attrs={}]<div data-ui="message" data-from="${from}"${a(attrs)}>[#if avatar?has_content]<div data-ui-part="avatar"><span data-ui="avatar" data-ui-part="avatar"><span data-ui-part="fallback">${avatar?esc}</span></span></div>[/#if]<div data-ui-part="body">[#if name?has_content]<div data-ui-part="header"><b>${name?esc}</b>[#if time?has_content] <span>${time?esc}</span>[/#if]</div>[/#if]<div data-ui-part="content">[#nested]</div>[#if actions?has_content]<div data-ui-part="actions">[#list actions as x]<button type="button" data-ui-part="action" data-action="${x}" aria-label="${x?cap_first}">${x?cap_first}</button>[/#list]</div>[/#if]</div></div>[/#macro]
[#macro marker variant="" icon="" live=false]<div data-ui="marker"${d("variant",variant)}[#if live] data-live[/#if]>[#if icon?has_content]<span data-ui-part="icon" data-icon="${icon}"></span>[/#if]<span data-ui-part="content">[#nested]</span></div>[/#macro]
[#macro spinner size="" variant="" label="Loading…" attrs={}]<span data-ui="spinner"${d("size",size)}${d("variant",variant)} data-label="${label?esc}"${a(attrs)}></span>[/#macro]
[#-- type: ""(actions) | single | multiple; value: "left" or "bold,italic" --]
[#macro buttonGroup label type="" value="" name="" orientation="" required=false attrs={}]<div data-ui="button-group" data-label="${label?esc}"${d("type",type)}${d("value",value)}${d("name",name)}${d("orientation",orientation)}[#if required] data-required[/#if]${a(attrs)}>[#nested]</div>[/#macro]
[#macro trace]<div data-ui="trace">[#nested]</div>[/#macro]
[#macro traceLine title icon="" status="" detail=""][#if detail?has_content]<div data-ui-part="line" data-ui="collapsible"${d("status",status)}><button type="button" data-ui-part="trigger"><span data-ui-part="icon" data-icon="${icon}"></span><span data-ui-part="title">${title?esc}</span></button><div data-ui-part="content"><pre>${detail?esc}</pre></div></div>[#else]<div data-ui-part="line"${d("status",status)}><span data-ui-part="icon" data-icon="${icon}"></span><span data-ui-part="title">${title?esc}</span></div>[/#if][/#macro]
[#macro attachment title description="" progress="" error=false removable=true]<div data-ui="attachment"[#if progress?has_content] data-progress="${progress}"[/#if][#if error] data-error[/#if]><span data-ui-part="media"></span><span data-ui-part="content"><span data-ui-part="title">${title?esc}</span>[#if description?has_content]<span data-ui-part="description">${description?esc}</span>[/#if][#if progress?has_content]<span data-ui-part="progress"></span>[/#if]</span>[#if removable]<span data-ui-part="actions"><button type="button" data-ui-part="action" data-action="remove" aria-label="Remove ${title?esc}">×</button></span>[/#if]</div>[/#macro]
[#-- items=[{"name","type":"single|multiple|text","title","description","required":bool,"skippable":bool,"choices":[{"value","label","description"}]}] --]
[#macro questionnaire items id="" submit="Submit"]<form data-ui="questionnaire"[#if id?has_content] id="${id}"[/#if]><div data-ui-part="progress"><span data-ui-part="label"></span></div>[#list items as q]<fieldset data-ui-part="item" data-name="${q.name}" data-type="${q.type!"single"}"[#if q.required!false] data-required[/#if][#if q.skippable!false] data-skippable[/#if]><legend data-ui-part="title">${q.title?esc}</legend>[#if q.description??]<p data-ui-part="description">${q.description?esc}</p>[/#if][#if (q.type!"single")=="text"]<textarea data-ui-part="input" name="${q.name}" aria-label="${q.title?esc}"></textarea>[#else]<div data-ui-part="choices">[#list q.choices as ch]<button type="button" data-ui-part="choice" data-value="${ch.value?esc}"><b>${ch.label?esc}</b>[#if ch.description??]<span>${ch.description?esc}</span>[/#if]</button>[/#list]</div>[/#if]<p data-ui-part="error"></p></fieldset>[/#list]<div data-ui-part="actions"><button type="button" data-ui-part="previous">Back</button><button type="button" data-ui-part="skip">Skip</button><button type="button" data-ui-part="next">Next</button><button type="submit" data-ui-part="submit">${submit?esc}</button></div><div data-ui-part="summary" tabindex="-1" hidden>[#nested]</div></form>[/#macro]
[#macro chart columns rows type="bar" caption="" showTable=false]<figure data-ui="chart" data-type="${type}"[#if showTable] data-show-table[/#if]>[#if caption?has_content]<figcaption>${caption?esc}</figcaption>[/#if]<table><thead><tr>[#list columns as c]<th>${c?esc}</th>[/#list]</tr></thead><tbody>[#list rows as r]<tr>[#list r as v]<td>${s(v)}</td>[/#list]</tr>[/#list]</tbody></table></figure>[/#macro]

[#-- ================= AI elements ================= --]
[#-- kind = chain-of-thought | plan | task | tool | reasoning | sources | subagent | stack-trace | test-results | terminal --]
[#macro agent kind title status="done" open=false id=""]<div data-ui="${kind}" data-status="${status}"[#if open] data-default-open[/#if][#if id?has_content] id="${id}"[/#if]><button type="button" data-ui-part="trigger"><span data-ui-part="label">${title?esc}</span>[#if kind=="plan"||kind=="task"] <span data-ui-part="progress"></span>[/#if][#if kind=="sources"] <span data-ui-part="count"></span>[/#if]<span data-ui-part="status"></span><i data-ui-part="chevron" aria-hidden="true"></i></button><div data-ui-part="content">[#if kind=="plan"||kind=="task"||kind=="chain-of-thought"]<ol data-ui-part="steps">[#nested]</ol>[#elseif kind=="terminal"]<pre data-ui-part="output">[#nested]</pre><button type="button" data-ui-part="copy">Copy</button>[#else][#nested][/#if]</div></div>[/#macro]
[#macro agentStep status="pending"]<li data-ui-part="step" data-status="${status}">[#nested]</li>[/#macro]
[#macro checkpoint id label restore="Restore"]<div data-ui="checkpoint" data-id="${id?esc}"><span data-ui-part="label">${label?esc}</span><button type="button" data-ui-part="restore">${restore?esc}</button></div>[/#macro]
[#macro confirmation title approve="Approve" reject="Reject"]<div data-ui="confirmation"><p data-ui-part="title">${title?esc}</p><p data-ui-part="description">[#nested]</p><div data-ui-part="actions"><button type="button" data-ui-part="reject">${reject?esc}</button><button type="button" data-ui-part="approve">${approve?esc}</button></div><p data-ui-part="result" tabindex="-1"></p></div>[/#macro]
[#macro context used max]<span data-ui="context" data-used="${used?c}" data-max="${max?c}"><span data-ui-part="meter"><span data-ui-part="bar"></span></span> <span data-ui-part="percent"></span></span>[/#macro]
[#-- nodes=[{"name","path","children":[…]?,"open":bool?,"status":"added|modified|deleted"?}] --]
[#macro fileTreeNodes nodes][#list nodes as n][#if n.children??]<li data-ui-part="folder" data-path="${n.path?esc}"[#if n.open!false] data-default-open[/#if]><span data-ui-part="label">${n.name?esc}</span><ul data-ui-part="group">[@fileTreeNodes n.children /]</ul></li>[#else]<li data-ui-part="file" data-path="${n.path?esc}"${d("status",n.status!"")}>${n.name?esc}</li>[/#if][/#list][/#macro]
[#macro fileTree nodes label="Files"]<ul data-ui="file-tree" aria-label="${label?esc}">[@fileTreeNodes nodes /]</ul>[/#macro]
[#macro promptInput id="prompt" name="prompt" placeholder="Ask anything…" attach=true]<form data-ui="prompt-input" id="${id}"><div data-ui-part="attachments"></div><textarea data-ui-part="input" name="${name}" rows="1" placeholder="${placeholder?esc}"></textarea><div data-ui-part="toolbar">[#if attach]<input type="file" data-ui-part="file" hidden multiple><button type="button" data-ui-part="attach">Attach</button>[/#if]<button data-ui-part="submit">Send</button></div></form>[/#macro]
[#-- pending/completed=[{"id","label"}] --]
[#macro queue pending=[] completed=[]]<div data-ui="queue"><h4>To do (<span data-ui-part="pending-count"></span>)</h4><ul data-ui-part="pending">[#list pending as i]<li data-ui-part="item" data-id="${s(i.id)}"><label><input type="checkbox"> ${i.label?esc}</label></li>[/#list]</ul><h4>Done (<span data-ui-part="completed-count"></span>)</h4><ul data-ui-part="completed">[#list completed as i]<li data-ui-part="item" data-id="${s(i.id)}" data-status="done"><label><input type="checkbox" checked> ${i.label?esc}</label></li>[/#list]</ul></div>[/#macro]
[#macro suggestion items target="" submit=false label="Suggestions"]<div data-ui="suggestion"${d("target",target)}[#if submit] data-submit[/#if] aria-label="${label?esc}">[#list items as s]<button type="button" data-ui-part="item">${s?esc}</button>[/#list]</div>[/#macro]
[#macro citation n href title source=""]<span data-ui="hover-card" data-ui-part="citation"><a data-ui-part="trigger" href="${href?esc}">${s(n)}</a><span data-ui-part="content"><b>${title?esc}</b>[#if source?has_content]<br>${source?esc}[/#if]<br>[#nested]</span></span>[/#macro]

[#-- ================= Sidebar blocks ================= --]
[#-- variant=sidebar|floating|inset; collapsible=offcanvas|icon|none; nested = groups; page content after [@ui.sidebarInset] --]
[#macro sidebarShell id="app-sidebar" variant="sidebar" collapsible="offcanvas" side="left" header="" footer="" title=""]<div data-ui-part="shell" data-variant="${variant}"><aside data-ui="sidebar" id="${id}" data-side="${side}" data-variant="${variant}" data-collapsible="${collapsible}" aria-label="Sidebar">[#if header?has_content]<div data-ui-part="header">${header}</div>[/#if]<div data-ui-part="content">[#nested]</div>[#if footer?has_content]<div data-ui-part="footer">${footer}</div>[/#if]<button type="button" data-ui-part="rail" data-ui-sidebar-toggle="#${id}" aria-label="Toggle sidebar" tabindex="-1"></button></aside>[/#macro]
[#macro sidebarInset sidebar="app-sidebar" title=""]<main data-ui-part="inset"><header data-ui-part="inset-header"><button type="button" data-ui-sidebar-toggle="#${sidebar}" aria-label="Toggle sidebar"></button>[#if title?has_content]<span>${title?esc}</span>[/#if]</header>[#nested]</main></div>[/#macro]
[#macro sidebarGroup label="" collapsible=false open=true][#if collapsible]<div data-ui="collapsible" data-ui-part="group"[#if open] data-default-open[/#if]><button type="button" data-ui-part="trigger">${label?esc}</button><div data-ui-part="content"><ul data-ui-part="menu">[#nested]</ul></div></div>[#else]<div data-ui-part="group">[#if label?has_content]<div data-ui-part="group-label">${label?esc}</div>[/#if]<ul data-ui-part="menu">[#nested]</ul></div>[/#if][/#macro]
[#-- sub=[{"href","label","current"?}] ; subMode=list|collapsible|dropdown --]
[#macro sidebarItem label href="#" icon="" current=false sub=[] subMode="collapsible" open=false][#if sub?has_content && subMode=="collapsible"]<li data-ui="collapsible"[#if open] data-default-open[/#if]><button type="button" data-ui-part="trigger" class="sb-mb">[#if icon?has_content]<span data-ui-part="icon" data-icon="${icon}"></span>[/#if]<span class="sb-text">${label?esc}</span><i data-ui-part="chevron" aria-hidden="true"></i></button><div data-ui-part="content"><ul data-ui-part="menu-sub">[#list sub as s]<li><a data-ui-part="menu-button" href="${s.href?esc}"[#if s.current!false] aria-current="page"[/#if]>${s.label?esc}</a></li>[/#list]</ul></div></li>[#elseif sub?has_content && subMode=="dropdown"]<li data-ui="dropdown-menu" data-side="right"><button type="button" data-ui-part="trigger" class="sb-mb"><span class="sb-text">${label?esc}</span></button><div data-ui-part="content">[#list sub as s]<a data-ui-part="item" href="${s.href?esc}">${s.label?esc}</a>[/#list]</div></li>[#else]<li><a data-ui-part="menu-button" href="${href?esc}"[#if current] aria-current="page"[/#if]>[#if icon?has_content]<span data-ui-part="icon" data-icon="${icon}"></span>[/#if]<span class="sb-text">${label?esc}</span></a>[#if sub?has_content]<ul data-ui-part="menu-sub">[#list sub as s]<li><a data-ui-part="menu-button" href="${s.href?esc}"[#if s.current!false] aria-current="page"[/#if]>${s.label?esc}</a></li>[/#list]</ul>[/#if]</li>[/#if][/#macro]

[#-- ================= Auth blocks (login / signup) ================= --]
[#macro authForm id action="" view="password" method="post" csrfName="" csrfToken=""]<form data-ui="auth-form" id="${id}" data-default-view="${view}"[#if action?has_content] action="${action?esc}" method="${method}"[/#if] novalidate>[#if csrfName?has_content]<input type="hidden" name="${csrfName}" value="${csrfToken?esc}">[/#if][#nested]<p data-ui-part="status"></p></form>[/#macro]
[#macro authView name next="" title="" description=""]<div data-ui-part="view" data-view="${name}"${d("next",next)}>[#if title?has_content]<header><h2>${title?esc}</h2>[#if description?has_content]<p>${description?esc}</p>[/#if]</header>[/#if][#nested]</div>[/#macro]
[#macro authField label name type="text" required=true placeholder="" autocomplete="" match="" minlength=""]<div data-ui="field"><label data-ui-part="label">${label?esc}</label>[#if type=="password"]<div data-ui="toggle-password"><input data-ui-part="input" type="password" name="${name}"[#if required] required[/#if]${d("match",match)}[#if minlength?has_content] minlength="${minlength}"[/#if][#if autocomplete?has_content] autocomplete="${autocomplete}"[/#if]><button type="button" data-ui-part="toggle" aria-label="Show password"></button></div>[#else]<input data-ui-part="control" type="${type}" name="${name}"[#if required] required[/#if][#if placeholder?has_content] placeholder="${placeholder?esc}"[/#if][#if autocomplete?has_content] autocomplete="${autocomplete}"[/#if]>[/#if]<p data-ui-part="error" hidden></p></div>[/#macro]
[#macro authProviders list=["google"] verb="Continue with"][#local names={"google":"Google","apple":"Apple","github":"GitHub","facebook":"Facebook","microsoft":"Microsoft"}]<div class="auth-providers">[#list list as p]<button type="button" data-ui="button" data-variant="outline" data-ui-part="provider" data-provider="${p}"><span>${verb?esc} ${names[p]!p?cap_first}</span></button>[/#list]</div>[/#macro]
