[#ftl output_format="HTML" auto_esc=true]
[#macro component model]
<div class="app-shell" data-application-component="shell"><aside class="app-nav suite-sidebar" data-app-part="sidebar"><button class="btn suite-close" type="button" data-app-part="close">Close menu</button><strong>${model.brand}</strong><nav class="suite-context" aria-label="Application navigation">[#list model.pages as page]<button type="button" class="btn" data-app-action="navigate" data-id="${page.id}">${page.title}</button>[/#list]</nav></aside><div class="app-stage"><header class="app-top"><button type="button" class="btn suite-menu" data-app-part="trigger" aria-expanded="false">Menu</button><strong>${model.brand}</strong></header><main class="app-main"><h1 data-app-heading="">${model.title}</h1><p data-app-description="">${model.description}</p>[#nested]</main></div><button type="button" class="suite-backdrop" data-app-part="backdrop" aria-label="Close navigation" hidden></button></div>
[/#macro]
