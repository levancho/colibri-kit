<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.l3v.colibri</groupId><artifactId>colibri-templates</artifactId><version>0.1.0</version>
  <name>Colibri Java templates</name><description>FreeMarker macros and native Thymeleaf fragments for Colibri Kit</description>
  <url>https://colibri-kit.io/java-templates.html</url>
  <licenses><license><name>MIT</name><url>https://opensource.org/licenses/MIT</url><distribution>repo</distribution></license></licenses>
  <!-- Maven Central requires project URL, licence, developers and SCM on every published POM. -->
  <developers><developer><id>levancho</id><name>Levan Dvalishvili</name><url>https://github.com/levancho</url></developer></developers>
  <scm>
    <connection>scm:git:https://github.com/levancho/colibri-kit.git</connection>
    <developerConnection>scm:git:https://github.com/levancho/colibri-kit.git</developerConnection>
    <url>https://github.com/levancho/colibri-kit/tree/main/java/colibri-templates</url>
  </scm>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><project.build.outputTimestamp>2026-11-03T00:00:00Z</project.build.outputTimestamp></properties>
  <!-- Engines are application dependencies, not shaded into the resource JAR. Tests exercise both. -->
  <dependencies>
    <dependency><groupId>org.freemarker</groupId><artifactId>freemarker</artifactId><version>2.3.35</version><scope>test</scope></dependency>
    <dependency><groupId>org.thymeleaf</groupId><artifactId>thymeleaf</artifactId><version>3.1.5.RELEASE</version><scope>test</scope></dependency>
    <dependency><groupId>org.thymeleaf</groupId><artifactId>thymeleaf-spring6</artifactId><version>3.1.5.RELEASE</version><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-webmvc</artifactId><version>6.2.11</version><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-test</artifactId><version>6.2.11</version><scope>test</scope></dependency>
    <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><version>6.0.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>../..</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include></includes></resource>
      <resource><directory>../../freemarker</directory><targetPath>templates/colibri/freemarker</targetPath></resource>
      <resource><directory>../../thymeleaf</directory><targetPath>templates/colibri/thymeleaf</targetPath></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version><configuration><archive><manifest><addDefaultEntries>false</addDefaultEntries></manifest></archive></configuration></plugin>
    </plugins>
  </build>
  <!-- Release to Maven Central: mvn -f java/colibri-templates/pom.xml -P release deploy
       Kept in a profile so the ordinary build and CI need neither a signing key nor credentials.
       See docs/publishing.md for the account, namespace, token and key this needs. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Central requires -sources and -javadoc jars. This artifact has templates and no Java code:
               the sources jar carries the templates, the javadoc jar a short note saying where the docs are. -->
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version>
            <executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
            <executions><execution><id>javadoc-placeholder</id><phase>package</phase><goals><goal>jar</goal></goals>
              <configuration><classifier>javadoc</classifier><classesDirectory>${project.basedir}/src/javadoc</classesDirectory></configuration></execution></executions></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
            <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
            <configuration><gpgArguments><arg>--pinentry-mode</arg><arg>loopback</arg></gpgArguments></configuration></plugin>
          <!-- Uploads the signed bundle to the Central Portal. autoPublish is off: a maintainer reviews the
               validated deployment at https://central.sonatype.com/publishing and presses Publish. -->
          <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.12.0</version><extensions>true</extensions>
            <configuration><publishingServerId>central</publishingServerId><autoPublish>false</autoPublish><deploymentName>colibri-templates ${project.version}</deploymentName></configuration></plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
